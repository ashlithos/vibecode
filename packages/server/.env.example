# Postgres. With Neon, use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URIs must include:
#   http://localhost:5178/api/auth/google/callback
#   https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Signs the session cookie. Any long random string: openssl rand -base64 32
AUTH_SECRET=""

# Comma-separated allowlist. Only these Google accounts may sign in.
# Leave empty to allow ANY Google account (open signup).
ALLOWED_EMAILS="you@example.com"

# Where OAuth callbacks come back to. Vercel sets VERCEL_URL automatically;
# only set this for local dev or a custom domain.
PUBLIC_BASE_URL="http://localhost:5178"
