{
  "name": "gym-copilot",
  "private": true,
  "version": "0.1.0",
  "description": "A personalized visual exercise library and gym copilot",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace @gym/server",
    "dev:web": "npm run dev --workspace @gym/web",
    "typecheck": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
